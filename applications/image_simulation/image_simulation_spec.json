[
  {
    "pointer": "/",
    "type": "object",
    "required": ["input", "distance", "tag_attributes"],
    "optional": [
      "output",
      "tags",
      "offset_tag",
      "finite_offset",
      "side",
      "relative_distance_and_length",
      "intermediate_output",
      "use_simplicial_embedding",
      "invert_tags",
      "report",
      "log_file",
      "input_path",
      "opt_log_level",
      "DEBUG_print_embedding",
      "DEBUG_print_offset",
      "DEBUG_print_smooth"
    ]
  },
  {
    "pointer": "/input",
    "type": "string"
  },
  {
    "pointer": "/distance",
    "type": "list",
    "min": 1,
    "doc": "List of desired offset distances."
  },
  {
    "pointer": "/distance/*",
    "type": "float",
    "min": 0,
    "doc": "Desired offset distance."
  },
  {
    "pointer": "/output",
    "type": "string",
    "default": ""
  },
  {
    "pointer": "/tags",
    "type": "list",
    "default": [],
    "doc": "List tags that should be used as input for the offset. If the list is empty, an offset is generated in between all tags. If one tag is given, the offset is computed around that tag region (can be combined with inside option). If two tags are given, the offset around the interface of the two tags is generated."
  },
  {
    "pointer": "/tags/*",
    "type": "list",
    "min": 2,
    "max": 2,
    "doc": "Input tags are given by the tag_attribute ID and the ID within that tag_attribute. For example, if tag_attributes are [tag_0, tag_1], then the tag 2 in tag_0 is [0,2]."
  },
  {
    "pointer": "/tags/*/*",
    "type": "int"
  },
  {
    "pointer": "/offset_tag",
    "type": "list",
    "default": [0, 0],
    "max": 1,
    "doc": "The tag assigned to the offset region. All unspecified tag_attributes are left untouched. Can currently only set one tag."
  },
  {
    "pointer": "/offset_tag/*",
    "type": "list",
    "min": 2,
    "max": 2
  },
  {
    "pointer": "/offset_tag/*/*",
    "type": "int"
  },
  {
    "pointer": "/tag_attributes",
    "type": "list",
    "min": 1,
    "doc": "All tag attributes that exist, e.g., segmentation and filter"
  },
  {
    "pointer": "/tag_attributes/*",
    "type": "string"
  },
  {
    "pointer": "/finite_offset",
    "type": "bool",
    "default": false,
    "doc": "If true, the component will compute a finite offset instead of the topological one."
  },
  {
    "pointer": "/side",
    "type": "string",
    "options": ["in", "out", "double"],
    "default": "out",
    "doc": "On which side of the input the offset should be generated: in = inside, out = outside, double = both sides."
  },
  {
    "pointer": "/relative_distance_and_length",
    "type": "bool",
    "default": true
  },
  {
    "pointer": "/intermediate_output",
    "type": "bool",
    "default": false
  },
  {
    "pointer": "/use_simplicial_embedding",
    "type": "bool",
    "default": true
  },
  {
    "pointer": "/invert_tags",
    "type": "bool",
    "default": false,
    "doc": "Switch inside and outside tags on top dimension simplices."
  },
  {
    "pointer": "/report",
    "type": "string",
    "default": "topological_offsets_report.json"
  },
  {
    "pointer": "/log_file",
    "type": "string",
    "default": "topological_offsets_log.txt"
  },
  {
    "pointer": "/input_path",
    "type": "string",
    "default": ""
  },
  {
    "pointer": "/opt_log_level",
    "type": "int",
    "default": 6
  },
  {
    "pointer": "/DEBUG_print_embedding",
    "type": "bool",
    "default": false,
    "doc": "Print intermediate embedding results"
  },
  {
    "pointer": "/DEBUG_print_offset",
    "type": "bool",
    "default": false,
    "doc": "Print intermediate offset results"
  },
  {
    "pointer": "/DEBUG_print_smooth",
    "type": "bool",
    "default": false,
    "doc": "Print intermediate smooth results"
  }
]
